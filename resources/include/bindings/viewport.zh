// @versionadded 3.0
enum ViewportMode
{
	// Position the viewport such that the [Viewport::Target] is in the middle of it (but bounded by the edges of the current region).
	VIEW_MODE_CENTER_AND_BOUND = 0L,
	// Position the viewport such that the [Viewport::Target] is in the middle of it, always. Screens outside the current region are rendered as black.
	VIEW_MODE_CENTER = 1L,
	// Disable the engine's updating of the viewport on every frame, and instead defer to values set by scripts.
	VIEW_MODE_SCRIPT = 2L
};

// Defines the visible portion of the current [Region] - aka, what the player currently sees.
//
// For an example usage, see: https://github.com/ZQuestClassic/ZQuestClassic/blob/main/tests/scripts/playground/auto/viewport.zs
//
// Access with `Viewport->`.
//
// @versionadded 2.55.9 Basic, read-only access
// @versionchanged 3.0 Full access via [Viewport->Mode]
class Viewport {
	// @delete
	internal Viewport();

	// Defaults to [VIEW_MODE_CENTER_AND_BOUND], and is reset at the beginning of scrolling.
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_MODE
	internal ViewportMode Mode;

	// The sprite that the viewport is centered around. If this sprite no longer exists,
	// this will be reset to the [Hero] sprite.
	//
	// Defaults to [Hero], and is reset at the beginning of scrolling.
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_TARGET
	internal sprite Target;

	// Width of the camera deadzone box, in pixels (0 to 240). While the [Target]'s center stays
	// within this box (centered on the camera's focus point), the camera does not move
	// horizontally; once the target pushes past an edge of the box, the camera moves just enough
	// to keep it on the edge.
	//
	// Defaults to the value set in the editor's Init Data 'Regions' tab (0 unless changed:
	// the camera stays locked to the target). Only observable in scrolling regions. Writing
	// to this overrides the Init Data value until the game is restarted or continued; write -1
	// to clear the override early (reading always returns the effective value, never -1).
	// Unlike [Mode] and [Target], it is NOT reset by scrolling or by camera cutscene effects.
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_DEADZONE_WIDTH
	internal int DeadzoneWidth;

	// Height of the camera deadzone box, in pixels (0 to 160). See [DeadzoneWidth].
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_DEADZONE_HEIGHT
	internal int DeadzoneHeight;

	// How far the camera aims ahead of the direction the [Target] is moving, in pixels
	// (-120 to 120). Positive values lead in front of the target (more frontal view);
	// negative values trail behind it. The lead applies per axis, so diagonal movement
	// leads by this much on both.
	//
	// While the target moves, the offset shifts toward the lead at [LookaheadSpeed] pixels
	// per frame (easing out on the axis it isn't moving along). While it stands still, the
	// offset holds, so the camera never drifts or reacts to turning in place. Warps and
	// camera cutscene effects drop the offset (it rebuilds as the target moves); scroll
	// transitions carry it. Only observable in scrolling regions.
	//
	// The offset the camera actually holds is capped on each axis so the viewport can
	// still reach the region edges: 120 - [DeadzoneWidth]/2 horizontally, and
	// 80 - [DeadzoneHeight]/2 vertically.
	//
	// Defaults to the value set in the editor's Init Data 'Regions' tab. Writing to this
	// overrides the Init Data value until the game is restarted or continued; unlike
	// [DeadzoneWidth], there is no sentinel to clear the override early.
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_LOOKAHEAD
	internal int Lookahead;

	// How fast the [Lookahead] offset shifts, in pixels per frame (0 to 240; 0 freezes
	// the current offset in place).
	//
	// Defaults to the value set in the editor's Init Data 'Regions' tab (1 unless
	// changed). Writing to this overrides the Init Data value until the game is restarted
	// or continued; write -1 to clear the override early (reading always returns the
	// effective value, never -1).
	//
	// @versionadded 3.0
	// @zasm_var VIEWPORT_LOOKAHEAD_SPEED
	internal int LookaheadSpeed;

	// Unless [Mode] is [VIEW_MODE_SCRIPT], this is updated every frame by the engine.
	//
	// @zasm_var VIEWPORT_X
	internal int X;

	// Unless [Mode] is [VIEW_MODE_SCRIPT], this is updated every frame by the engine.
	//
	// @zasm_var VIEWPORT_Y
	internal int Y;

	// @zasm_var VIEWPORT_WIDTH
	internal const int Width;

	// @zasm_var VIEWPORT_HEIGHT
	internal const int Height;

	// Returns true if the given sprite is visible within the viewport.
	//
	// Note: this function ignores the fact that the bottom 8 pixels may not be visible
	// given [qr_HIDE_BOTTOM_8_PIXELS].
	//
	// @versionadded 3.0
	bool Contains(sprite s)
	{
		int t = s->Y;
		int b = s->Y + s->TileHeight*16;
		int l = s->X;
		int r = s->X + s->TileWidth*16;
		return this->X <= r && this->X + this->Width > l && this->Y <= b && this->Y + this->Height > t;
	}

	// Returns true if the given point is visible within the viewport.
	//
	// Note: this function ignores the fact that the bottom 8 pixels may not be visible
	// given [qr_HIDE_BOTTOM_8_PIXELS].
	//
	// @versionadded 3.0
	bool Contains(int x, int y)
	{
		return x >= this->X && x < this->X + this->Width && y >= this->Y && y < this->Y + this->Height;
	}
}

internal const Viewport Viewport;
