+
+		// FDS has RAM at $8000-DFFF; checked after the expansion chips
+		// so their registers in this range keep precedence
+		if ( fds )
+		{
+			if ( (unsigned) (addr - fds->sram_addr) < sizeof fds->sram )
+			{
+				fds->sram [addr - fds->sram_addr] = data;
