+		case cmd_pcm_seek: {
+			// The offset comes from the file, so keep it within the data.
+			long offset = pos [3] * 0x1000000L + pos [2] * 0x10000L +
 					pos [1] * 0x100L + pos [0];
+			pcm_pos = offset < data_end - pcm_data ? pcm_data + offset : data_end;
 			pos += 4;
 			break;
